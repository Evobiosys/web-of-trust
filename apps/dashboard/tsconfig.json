{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "vitest/globals"],
    "composite": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src", "vite.config.ts"]
}
