# Every line has a hermetic fallback — empty means "use the in-stack container / default".
MATRIX_HOMESERVER_URL=        # Jakob's own instance → fallback: local synapse container (--profile local)
MATRIX_REGISTRATION_SECRET=   # to create @*-agent accounts → fallback: local synapse auto-provisioning secret
OLLAMA_URL=http://localhost:11434   # host ollama (exists on this machine) → fallback: ollama container (CPU)
CHAT_MODEL=qwen3:4b                 # doc default qwen2.5:3b-instruct not pulled — see DECISIONS.md D4
EMBED_MODEL=qwen3-embedding:8b      # doc default bge-m3 not pulled — multilingual substitute, D4
